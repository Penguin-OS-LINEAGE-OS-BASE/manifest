<?xml version="1.0" encoding="UTF-8"?>
<!--
  PenguinOS on Lineage base — manifest overlay v1 (QS panel + bootable base).

  Usage (on top of the Lineage android manifest repo):
    <remote name="penguin" fetch="https://github.com" />
    <project path="manifest" name="Penguin-OS-LINEAGE-OS-BASE/manifest" remote="penguin" revision="lineage-24.0">
      <linkfile src="penguin.xml" dest="manifest/penguin.xml" />
    </project>
  then `repo sync` picks up every override below.

  Convention: our Lineage forks keep `android_*` names; Penguin-original apps
  keep their old names. frameworks/base tracks branch `penguin-qs`
  (QS hook port; stock behavior unchanged without the PenguinSystemUI app).
-->
<manifest>
  <remote name="penguin" fetch="https://github.com" />

  <!-- Core / build (clean Lineage forks, track lineage-24.0) -->
  <remove-project name="LineageOS/android_art" />
  <project path="art" name="Penguin-OS-LINEAGE-OS-BASE/android_art" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_bionic" />
  <project path="bionic" name="Penguin-OS-LINEAGE-OS-BASE/android_bionic" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="Penguin-OS-LINEAGE-OS-BASE/android_bootable_recovery" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_build" />
  <project path="build/make" name="Penguin-OS-LINEAGE-OS-BASE/android_build" remote="penguin" revision="lineage-24.0">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <remove-project name="LineageOS/android_build_soong" />
  <project path="build/soong" name="Penguin-OS-LINEAGE-OS-BASE/android_build_soong" remote="penguin" revision="lineage-24.0">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <remove-project name="LineageOS/android_development" />
  <project path="development" name="Penguin-OS-LINEAGE-OS-BASE/android_development" remote="penguin" revision="lineage-24.0" />

  <!-- Frameworks -->
  <remove-project name="LineageOS/android_frameworks_av" />
  <project path="frameworks/av" name="Penguin-OS-LINEAGE-OS-BASE/android_frameworks_av" remote="penguin" revision="lineage-24.0" />
  <!-- QS HOOK PORT: additive only (+31/-0). Without the PenguinSystemUI app,
       qsPanels.orElse(null) == null and the stock QS path runs. -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="Penguin-OS-LINEAGE-OS-BASE/android_frameworks_base" remote="penguin" revision="penguin-qs" />
  <remove-project name="LineageOS/android_frameworks_libs_systemui" />
  <project path="frameworks/libs/systemui" name="Penguin-OS-LINEAGE-OS-BASE/android_frameworks_libs_systemui" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_frameworks_native" />
  <project path="frameworks/native" name="Penguin-OS-LINEAGE-OS-BASE/android_frameworks_native" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_frameworks_opt_telephony" />
  <project path="frameworks/opt/telephony" name="Penguin-OS-LINEAGE-OS-BASE/android_frameworks_opt_telephony" remote="penguin" revision="lineage-24.0" />

  <!-- Hardware -->
  <remove-project name="LineageOS/android_hardware_interfaces" />
  <project path="hardware/interfaces" name="Penguin-OS-LINEAGE-OS-BASE/android_hardware_interfaces" remote="penguin" revision="lineage-24.0" />
  <remove-project name="platform/hardware/libhardware" />
  <project path="hardware/libhardware" name="Penguin-OS-LINEAGE-OS-BASE/android_hardware_libhardware" remote="penguin" revision="lineage-24.0" />
  <remove-project name="platform/hardware/libhardware_legacy" />
  <project path="hardware/libhardware_legacy" name="Penguin-OS-LINEAGE-OS-BASE/android_hardware_libhardware_legacy" remote="penguin" revision="lineage-20.0" />
  <remove-project name="platform/hardware/ril" />
  <project path="hardware/ril" name="Penguin-OS-LINEAGE-OS-BASE/android_hardware_ril" remote="penguin" revision="lineage-22.2" />
  <remove-project name="platform/libcore" />
  <project path="libcore" name="Penguin-OS-LINEAGE-OS-BASE/android_libcore" remote="penguin" revision="lineage-21.0" />

  <!-- System -->
  <remove-project name="LineageOS/android_system_core" />
  <project path="system/core" name="Penguin-OS-LINEAGE-OS-BASE/android_system_core" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_system_media" />
  <project path="system/media" name="Penguin-OS-LINEAGE-OS-BASE/android_system_media" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_system_netd" />
  <project path="system/netd" name="Penguin-OS-LINEAGE-OS-BASE/android_system_netd" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_system_sepolicy" />
  <project path="system/sepolicy" name="Penguin-OS-LINEAGE-OS-BASE/android_system_sepolicy" remote="penguin" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_system_vold" />
  <project path="system/vold" name="Penguin-OS-LINEAGE-OS-BASE/android_system_vold" remote="penguin" revision="lineage-24.0" />

  <!-- Vendor: use vendor/penguin, never vendor/lineage -->
  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/penguin" name="Penguin-OS-LINEAGE-OS-BASE/android_vendor_penguin" remote="penguin" revision="lineage-24.0" />

  <!-- Penguin apps: Dialer (already in new org) + PenguinSystemUI (QS panel) -->
  <remove-project name="LineageOS/android_packages_apps_Dialer" />
  <project path="packages/apps/Dialer" name="Penguin-OS-LINEAGE-OS-BASE/penguin_packages_apps_Dialer" remote="penguin" revision="celerity" />
  <project path="packages/apps/PenguinSystemUI" name="Penguin-OS-LINEAGE-OS-BASE/penguin_packages_apps_PenguinSystemUI" remote="penguin" revision="celerity" />
</manifest>
